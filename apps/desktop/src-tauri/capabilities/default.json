{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: magi's own commands and engine events. No filesystem or opener access from the webview (SPEC.md §5.7). Plan 5 splits this per window.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-ping", "allow-search", "allow-get-status", "allow-list-roots",
    "allow-add-root", "allow-remove-root", "allow-set-root-enabled",
    "allow-pause-indexing", "allow-resume-indexing", "allow-rescan-all",
    "allow-open-file", "allow-reveal-file", "allow-get-settings",
    "allow-update-settings", "allow-list-errors", "allow-retry-errors",
    "allow-features-status", "allow-set-feature-enabled", "allow-download-feature",
    "allow-cancel-download", "allow-remove-download", "allow-clear-index"
  ]
}
